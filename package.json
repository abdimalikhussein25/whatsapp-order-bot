{
  "name": "whatsapp-order-bot",
  "version": "0.1.0",
  "description": "Take food and shop orders on WhatsApp in Somali: menu, cart, delivery address and owner alerts on the official WhatsApp Cloud API.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "author": "Abdimalik Salad Hussein",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
