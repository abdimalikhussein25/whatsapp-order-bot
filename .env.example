# From Meta for Developers → your app → WhatsApp → API Setup
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# App settings → Basic → App secret (used to verify webhook signatures)
WA_APP_SECRET=
# Any random string; paste the same value into the webhook config in Meta
WA_VERIFY_TOKEN=
# Optional: the shop owner's number (international, no +) receives every new order
OWNER_PHONE=
PORT=3000
